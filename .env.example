# APP_URL: The public URL where this applet is hosted.
# Used for public pairing QR code URLs and links.
APP_URL="https://example.com"

# LAN_IP: Optional explicit LAN IPv4 address for Wi-Fi / local network device pairing (e.g. 192.168.1.3)
LAN_IP="192.168.1.3"

# PORT: The port the server listens on (default 3000 in AI Studio)
PORT="3000"

# SIGNALING: Optional custom WebSocket URL override if hosted separately.
# If unset, the browser connects to ws(s)://<current-host>/ws/signaling
# VITE_SIGNALING_URL="wss://example.com/ws/signaling"

# ICE & STUN / TURN Configuration:
# Default STUN servers used for NAT discovery:
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# Optional TURN Relay Configuration (for symmetric NAT traversal / cross-network fallback):
# Leave blank if not configured. When configured, credentials are dynamically issued via /api/turn-credentials
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Session Configuration & Limits:
# Inactive session expiry in seconds (default 300s = 5 minutes)
SESSION_EXPIRY_SECONDS="300"
# Maximum allowed files per single transfer batch
MAX_FILES_COUNT="50"
# Maximum total transfer size in bytes (default 10 GB: 10737418240 bytes)
MAX_TOTAL_SIZE_BYTES="10737418240"
# Maximum size per individual file in bytes (default 5 GB: 5368709120 bytes)
MAX_FILE_SIZE_BYTES="5368709120"
